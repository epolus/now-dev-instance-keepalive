<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — ServiceNow Keep-Alive</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/" class="brand">ServiceNow Keep-Alive</a>
    <div class="nav-actions">
      <a href="/instances/new" class="btn btn-primary btn-sm">+ Add Instance</a>
      <form action="/logout" method="POST" class="inline-form">
        <button type="submit" class="btn btn-ghost btn-sm">Logout</button>
      </form>
    </div>
  </nav>
  <main class="container">
    <% if (flash) { %>
      <div class="alert alert-info"><%= flash %></div>
    <% } %>

    <section class="section">
      <h2>Instances</h2>
      <% if (instances.length === 0) { %>
        <div class="empty-state">
          <p>No instances configured yet.</p>
          <a href="/instances/new" class="btn btn-primary">Add your first instance</a>
        </div>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Name</th>
                <th>URL</th>
                <th>Status</th>
                <th>Last Run</th>
                <th>Last Result</th>
                <th>Next Run</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% instances.forEach(function(inst) { %>
              <tr>
                <td><strong><%= inst.name %></strong></td>
                <td class="mono"><%= inst.instance_url %></td>
                <td>
                  <% if (inst.isRunning) { %>
                    <span class="badge badge-running">Running</span>
                  <% } else if (inst.enabled) { %>
                    <span class="badge badge-enabled">Enabled</span>
                  <% } else { %>
                    <span class="badge badge-disabled">Disabled</span>
                  <% } %>
                </td>
                <td><%= inst.last_run_at ? new Date(inst.last_run_at).toLocaleString() : '—' %></td>
                <td>
                  <span class="badge badge-<%= inst.last_result_label === 'success' ? 'success' : inst.last_result_label === 'fail' ? 'fail' : 'never' %>">
                    <%= inst.last_result_label %>
                  </span>
                </td>
                <td><%= inst.next_run_at && inst.enabled ? new Date(inst.next_run_at).toLocaleString() : '—' %></td>
                <td class="actions">
                  <form action="/instances/<%= inst.id %>/run" method="POST" class="inline-form">
                    <button type="submit" class="btn btn-sm" <%= inst.isRunning ? 'disabled' : '' %>>Run now</button>
                  </form>
                  <form action="/instances/<%= inst.id %>/test" method="POST" class="inline-form">
                    <button type="submit" class="btn btn-sm btn-secondary" <%= inst.isRunning ? 'disabled' : '' %>>Test login</button>
                  </form>
                  <a href="/instances/<%= inst.id %>/edit" class="btn btn-sm btn-ghost">Edit</a>
                  <form action="/instances/<%= inst.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Delete instance <%= inst.name %>?')">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                  </form>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="section">
      <h2>Recent Login Logs</h2>
      <% if (recentLogs.length === 0) { %>
        <p class="muted">No login attempts recorded yet.</p>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Time</th>
                <th>Instance</th>
                <th>Result</th>
                <th>Message</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <% recentLogs.forEach(function(log) { %>
              <tr>
                <td><%= new Date(log.timestamp).toLocaleString() %></td>
                <td><%= log.instance_name %></td>
                <td>
                  <span class="badge badge-<%= log.success ? 'success' : 'fail' %>">
                    <%= log.success ? 'success' : 'fail' %>
                  </span>
                </td>
                <td class="message-cell"><%= log.message %></td>
                <td><%= log.duration_ms %>ms</td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
