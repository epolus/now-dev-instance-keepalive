# Admin login credentials
ADMIN_USER=admin
# Generate with: npm run hash-password -- yourpassword
# Recommended for Docker — no $ escaping needed:
ADMIN_PASSWORD_HASH_B64=replace_with_base64_hash_from_hash_password_script
# Or for local npm run only:
# ADMIN_PASSWORD_HASH=$2b$10$...

# Session secret (random string, at least 32 chars)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# AES-256-GCM key for encrypting ServiceNow credentials (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Server (PORT = app listen port inside container; HOST_PORT = host mapping in docker-compose)
PORT=3000
HOST_PORT=3001
NODE_ENV=production
COOKIE_SECURE=false

# Set COOKIE_SECURE=true when running behind HTTPS reverse proxy

# SQLite database path (inside container, mounted as volume)
DB_PATH=/data/keepalive.db

# Login job timeout in milliseconds
LOGIN_TIMEOUT_MS=30000
